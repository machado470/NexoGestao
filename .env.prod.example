# Production environment contract. Copy to .env.prod and replace every required placeholder.
# This file contains names/placeholders only; never commit .env.prod or real credentials.
NODE_ENV=production

# PostgreSQL (DATABASE_URL must describe the same Compose database)
POSTGRES_USER=<required-dedicated-user>
POSTGRES_PASSWORD=<required-secret-min-16-chars>
POSTGRES_DB=<required-database-name>
DATABASE_URL=postgresql://<user>:<password>@postgres:5432/<database>?schema=public

# Redis
REDIS_PASSWORD=<required-secret-min-16-chars>
REDIS_URL=redis://:<password>@redis:6379

# Authentication and bootstrap
JWT_SECRET=<required-random-secret-min-32-chars>
BOOTSTRAP_SECRET=<optional-one-time-bootstrap-secret>
AUTH_ENFORCE_EMAIL_VERIFICATION=true

# Public routing
DOMAIN=<required-public-domain>
EMAIL=<optional-lets-encrypt-contact>
APP_URL=https://app.<domain>
FRONTEND_URL=https://app.<domain>
CORS_ORIGINS=https://app.<domain>
VITE_API_URL=https://api.<domain>

# Stripe (required by the production application contract)
STRIPE_SECRET_KEY=<required-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<required-stripe-webhook-secret>
STRIPE_PRICE_STARTER=<required-stripe-price-id>
STRIPE_PRICE_PRO=<required-stripe-price-id>
STRIPE_PRICE_BUSINESS=<required-stripe-price-id>

# WhatsApp: choose meta_cloud or zapi; fill only the selected provider's credentials.
WHATSAPP_PROVIDER=<meta_cloud-or-zapi>
META_ACCESS_TOKEN=<required-when-meta-cloud>
META_PHONE_NUMBER_ID=<required-when-meta-cloud>
META_APP_SECRET=<required-when-meta-cloud>
META_API_VERSION=<optional-api-version>
ZAPI_INSTANCE_ID=<required-when-zapi>
ZAPI_TOKEN=<required-when-zapi>
ZAPI_CLIENT_TOKEN=<required-when-zapi>

# Canonical backup. RETENTION_DAYS is technical retention, not an RPO.
BACKUP_DIR=<required-writable-absolute-path>
RETENTION_DAYS=<days>
DB_CONTAINER=<postgres-container-name>
BACKUP_S3_BUCKET=<optional-bucket-name>
BACKUP_S3_REGION=<optional-aws-region>
BACKUP_S3_PREFIX=<optional-object-prefix>

# Optional observability
SENTRY_DSN=<optional-api-dsn>
VITE_SENTRY_DSN=<optional-web-dsn>
SENTRY_ENVIRONMENT=production

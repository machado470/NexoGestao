# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl ca-certificates curl postgresql-client \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm install -g pnpm@10.30.3
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY apps/api/package.json apps/api/package.json
COPY packages/common/package.json packages/common/package.json

FROM base AS builder
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    pnpm install --frozen-lockfile
COPY . .
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    pnpm prepare:workspace
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    pnpm --filter ./apps/api build
# Preserve the generated client across the production-only dependency install.
RUN node -e 'const fs=require("fs"),p=require("path"); fs.cpSync(p.dirname(require.resolve(".prisma/client/package.json", {paths:[require.resolve("@prisma/client")]})), "/opt/prisma-client", {recursive:true})'

FROM base AS production-deps
ENV PRISMA_SKIP_POSTINSTALL_GENERATE=true
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    pnpm install --prod --frozen-lockfile

FROM production-deps AS runtime
ENV NODE_ENV=production
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/packages/common/dist ./packages/common/dist
COPY --from=builder /opt/prisma-client /opt/prisma-client
RUN client_dir="$(node -p 'require("path").dirname(require.resolve("@prisma/client/package.json"))')" \
    && mkdir -p "$client_dir/../../.prisma" \
    && cp -r /opt/prisma-client "$client_dir/../../.prisma/client" \
    && rm -rf /opt/prisma-client
COPY scripts/check-operational-actions-db.mjs scripts/wait-for-postgres.mjs ./scripts/
COPY apps/api/docker-entrypoint.sh ./apps/api/docker-entrypoint.sh
RUN chmod +x apps/api/docker-entrypoint.sh
WORKDIR /app/apps/api
EXPOSE 3000
ENTRYPOINT ["/app/apps/api/docker-entrypoint.sh"]
CMD ["node", "dist/main.js"]

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile.railway"
  },
  "deploy": {
    "startCommand": "sh scripts/start-railway-api.sh",
    "preDeployCommand": ["pnpm prisma:migrate:deploy"],
    "healthcheckPath": "/v1/health/readiness",
    "healthcheckTimeout": 240,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}

# Copy outside the repository, restrict to the service account, and replace placeholders.
BACKUP_MODE=local
BACKUP_DIR=/absolute/path/to/backup-artifacts
BACKUP_STATE_DIR=/absolute/path/to/backup-state
RETENTION_DAYS=30
# Explicit container source; it must be running. There is no host fallback.
DB_CONTAINER=replace-with-confirmed-postgres-container
# Host source alternative: remove DB_CONTAINER and configure both values below.
# POSTGRES_HOST=replace-with-confirmed-postgres-host
# POSTGRES_PORT=5432
POSTGRES_USER=replace-me
POSTGRES_DB=replace-me
# For local_and_offsite only (implementation is not proof of real offsite controls):
# BACKUP_S3_BUCKET=replace-me
# BACKUP_S3_REGION=sa-east-1
# BACKUP_S3_PREFIX=backups/postgres
